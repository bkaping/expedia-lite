# Copy this file to .env and replace the placeholder locally.
# Do not commit the real .env file.
GEOAPIFY_API_KEY=PASTE_YOUR_GEOAPIFY_KEY_HERE
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_KEY_HERE
# The free router selects from currently available free models. You may override this with a specific available model slug.
OPENROUTER_MODEL=openrouter/free
