# Copy this file to .env and replace the placeholder locally. Do not commit the real .env file.
# The paced-breathing practice and history work without a key. This key enables only the optional companion.
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_KEY_HERE
# The free router selects from currently available free models. You may override it with a specific available model slug.
OPENROUTER_MODEL=openrouter/free
